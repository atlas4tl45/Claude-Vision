# Copy to server/.env and fill in. Never commit server/.env.

# Required. At least 32 characters. Generate with: npm run token
CV_AUTH_TOKEN=

# Where to listen. Only loopback or a Tailscale address is accepted;
# 0.0.0.0 / :: are refused. "tailscale" auto-detects the Tailscale IP.
CV_BIND_HOST=127.0.0.1
CV_PORT=8787

# Sessions may only use directories inside this root.
CV_PROJECTS_ROOT=~/Projects

# Optional overrides (macOS defaults shown).
# CV_DATA_DIR=~/Library/Application Support/ClaudeVision
# CV_LOG_DIR=~/Library/Logs/ClaudeVision
# CV_LOG_LEVEL=info

# "sdk" (real Claude) or "fake" (echo backend for UI development, no API calls).
# CV_AGENT_BACKEND=sdk

# Optional model override passed to the Agent SDK.
# CV_MODEL=

# The Agent SDK authenticates the same way Claude Code does: either be logged
# in with `claude` on this machine, or set ANTHROPIC_API_KEY here.
# ANTHROPIC_API_KEY=
