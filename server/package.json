{
  "name": "claude-vision-server",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code session server for the Claude Vision visionOS client",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "CV_AGENT_BACKEND=fake node --disable-warning=ExperimentalWarning src/index.ts",
    "client": "node cli/client.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "gen": "node ../protocol/scripts/gen-ts.mjs",
    "gen:check": "node ../protocol/scripts/gen-ts.mjs --check",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
